{
  "version": 2,
  "name": "suges-privacy-policy",
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/image_logo\\.png", "headers": { "Content-Type": "image/png", "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/(.+\\.(png|ico|jpg|jpeg|gif|svg|woff2?|ttf|eot))", "dest": "/$1" },
    { "src": "/privacy\\.html", "dest": "/privacy.html" },
    { "src": "/terms\\.html", "dest": "/terms.html" },
    { "src": "/eula\\.html", "dest": "/eula.html" },
    { "src": "/deletion\\.html", "dest": "/deletion.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}